# FoodBridge Backend Environment Variables

APP_NAME="FoodBridge Connect"
ENV="development"
PORT=8000
SECRET_KEY="foodbridge-secret-key-change-in-production"

# Azure AI Services & Maps API
AZURE_AI_ENDPOINT="https://foodbridge-ai.cognitiveservices.azure.com"
AZURE_AI_KEY="your-azure-ai-key-here"
AZURE_MAPS_KEY="your-azure-maps-key-here"

# Supabase Credentials
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "https://foodbridge-connect.azurewebsites.net"]
